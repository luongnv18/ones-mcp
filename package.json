{
  "name": "ones-mcp-server",
  "version": "1.0.0",
  "description": "Portable MCP server for ONES Wiki and Project/Issue management with browser 2FA login and auto-refresh",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ones-mcp-server": "dist/index.js",
    "ones-mcp": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); ['dist/index.js','dist/cli.js'].forEach(f=>{if(fs.existsSync(f))fs.chmodSync(f,0o755);})\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "login": "node dist/cli.js login",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "playwright-core": "^1.65.0",
    "turndown": "^7.2.5",
    "unpdf": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
